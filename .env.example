# Katapatha environment, one file for the whole repo.
#
# Every variable the repo reads, in one place. Nothing here is a secret: every
# value is a local development default.
#
# Where each app looks:
#   apps/api   reads apps/api/.env   (cp apps/api/.env.example apps/api/.env)
#   apps/web   reads apps/web/.env   (cp apps/web/.env.example apps/web/.env)
#   docker compose reads ./.env next to the compose file (POSTGRES_PASSWORD,
#   ALLOW_DEMO_ACCESS, OSRM_URL)
# The local defaults work with no .env at all except DATABASE_URL, which the
# API needs. `.env` files are git-ignored; never commit a real one.

# ── Database (apps/api) ──────────────────────────────────────────────────────
# Postgres 17 from `pnpm db:up`. Inside docker compose the host is `db`.
DATABASE_URL="postgresql://katapatha:katapatha@localhost:5432/katapatha?schema=public"

# Only read by docker-compose.coolify.yml (production compose). Required there.
# POSTGRES_PASSWORD=change-me-to-a-long-random-value

# ── API server (apps/api) ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Bind address. Defaults to localhost in development and 0.0.0.0 in production.
# HOST=localhost
# Fastify log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# ── Seeding (apps/api/prisma/seed) ───────────────────────────────────────────
# Folder holding the competition CSVs. If it holds the expected files the seeder
# uses the real data, otherwise the committed synthetic fixture. The real data
# is confidential: keep it outside this repo.
# DATA_DIR="../katapatha-project/data"
# Set to 1 to re-seed even when the database says it is already seeded.
# SEED_FORCE=1
# The day `pnpm demo:morning` stages. Defaults to the hero day.
# SCENARIO_DATE=2026-04-09

# ── Road routing (optional) ──────────────────────────────────────────────────
# OSRM over OpenStreetMap. Build with `pnpm osrm:prepare`, run with
# `pnpm osrm:up`. Leave unset to plan on straight-line estimates.
# Use 127.0.0.1, not localhost: on macOS localhost:5000 is AirPlay Receiver.
# OSRM_URL=http://127.0.0.1:5000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# The real API. The Prism mock (`pnpm mock`) serves paths at the root instead:
# http://localhost:4010
API_BASE_URL="http://localhost:3001/v1"
# Public origin, used for absolute share-image URLs.
# SITE_URL=http://localhost:3000

# ── Review accounts (apps/api + apps/web) ────────────────────────────────────
# Enables /access, the one-click sign-in page for the seeded accounts. It is
# on automatically when NODE_ENV is development or test. Keep 0 in production.
# ALLOW_DEMO_ACCESS=0

# ── Native driver app (apps/mobile) ──────────────────────────────────────────
# The API as a physical phone sees it: your machine's LAN address, not localhost.
# KATAPATHA_API_BASE_URL=http://192.168.1.20:3001/v1
